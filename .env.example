# Optional Firebase sync.
# Leave both values unset for local-only mode.

# Option 1: inline Firebase Web App configuration.
# FE_FIREBASE_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Option 2: URL returning JSON or: export const firebaseConfig = {...};
# FE_FIREBASE_CONFIG_URL=https://example.com/firebase-client-settings.js
